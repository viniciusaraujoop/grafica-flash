{
    "name":  "grafica-flash",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "eslint",
                    "test":  "npm run test:foundation && npm run test:customer-portal",
                    "test:foundation":  "tsc -p tests/foundation/tsconfig.json && node --test .next/foundation-tests/tests/foundation/*.test.js",
                    "test:customer-portal":  "tsc -p tests/customer-portal/tsconfig.json && node --test .next/customer-portal-tests/tests/customer-portal/*.test.js",
                    "security:check":  "node scripts/security-check.mjs",
                    "verify:payments":  "node scripts/verify-payment-flow-boundaries.mjs",
                    "verify:payment-credentials":  "node scripts/auditar-isolamento-pagamentos.cjs"
                },
    "dependencies":  {
                         "@supabase/supabase-js":  "^2.108.1",
                         "next":  "16.2.9",
                         "qrcode":  "^1.5.4",
                         "react":  "19.2.4",
                         "react-dom":  "19.2.4",
                         "@supabase/ssr":  "0.12.3"
                     },
    "devDependencies":  {
                            "@tailwindcss/postcss":  "^4",
                            "@types/node":  "^20",
                            "@types/qrcode":  "^1.5.6",
                            "@types/react":  "^19",
                            "@types/react-dom":  "^19",
                            "eslint":  "^9",
                            "eslint-config-next":  "16.2.9",
                            "tailwindcss":  "^4",
                            "typescript":  "^5"
                        }
}
